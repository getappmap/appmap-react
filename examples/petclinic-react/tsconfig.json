{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@funwithappmap/react-recorder": ["../../recorder/src/index.ts"],
      "@funwithappmap/react-recorder/vitest": ["../../recorder/src/vitest.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "../../recorder/src"]
}

{
  "name": "@funwithappmap/react-recorder",
  "private": true,
  "version": "0.0.1",
  "description": "Hand-instrumentation AppMap recorder for React (spike for docs/design/01).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vitest": "./src/vitest.ts",
    "./vite": "./src/vitePlugin.ts",
    "./transform": "./src/transform.ts"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./vitest": "./dist/vitest.js",
      "./vite": "./dist/vitePlugin.js",
      "./transform": "./dist/transform.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "^7.26.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "jsdom": "^26.1.0",
    "msw": "^2.7.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
